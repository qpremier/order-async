# Shopify app credentials are supplied by Shopify CLI in local app dev.
# Fill these for Docker or non-CLI runtime environments.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://example.com
SCOPES=write_products,write_metaobjects,write_metaobject_definitions
SHOP_CUSTOM_DOMAIN=

# PostgreSQL is the application source of truth.
DATABASE_URL=postgresql://orderrelay:orderrelay@localhost:5432/orderrelay_development?schema=public
WEB_DATABASE_URL=postgresql://orderrelay:orderrelay@postgres:5432/orderrelay_development?schema=public

# Redis backs BullMQ queues. PostgreSQL remains the durable source of truth.
REDIS_URL=redis://localhost:6379
WEB_REDIS_URL=redis://redis:6379

# Local Docker Compose database defaults. Do not reuse these as production secrets.
POSTGRES_USER=orderrelay
POSTGRES_PASSWORD=orderrelay
POSTGRES_DB=orderrelay_development

LOG_LEVEL=info
ORDER_WORKER_CONCURRENCY=5
CATALOG_WORKER_CONCURRENCY=2
CATALOG_SYNC_PAGE_SIZE=100
CATALOG_STALE_AFTER_MINUTES=60
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=10000
JOB_MAX_ATTEMPTS=5
RATE_LIMIT_SAFETY_MARGIN=0.8
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
