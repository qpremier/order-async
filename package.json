{
  "name": "order-sync",
  "private": true,
  "scripts": {
    "build": "npm run build:web && npm run worker:build",
    "build:web": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run migrate:deploy && npm run start",
    "worker:dev": "node worker/index.js",
    "worker:build": "node scripts/check-javascript.mjs worker app/queues app/services app/db.server.js app/shopify.server.js",
    "worker:start": "node worker/index.js",
    "setup": "npm run prisma:generate && npm run migrate:deploy",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "vite": "vite",
    "check": "npm run lint && node scripts/check-javascript.mjs app worker tests vite.config.js vitest.config.js react-router.config.js",
    "test": "vitest run"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "bullmq": "^6.3.4",
    "csv-parse": "^6.1.0",
    "ioredis": "^6.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.6.2",
    "vite": "^6.3.6",
    "vitest": "2.1.9"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "m.qasim"
}
